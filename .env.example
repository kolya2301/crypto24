NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Уже настроено под docker-compose.yml — менять не нужно для локальной разработки
DATABASE_URL="postgresql://cryptochange:cryptochange_dev@localhost:5432/cryptochange"

# ─── Redis ────────────────────────────────────────────────────────────────────
# Уже настроено под docker-compose.yml — менять не нужно для локальной разработки
REDIS_URL="redis://:cryptochange_redis_dev@localhost:6379"

# ─── JWT / Session ────────────────────────────────────────────────────────────
# !! ОБЯЗАТЕЛЬНО ЗАМЕНИТЬ !!
# Сгенерировать: openssl rand -base64 48
JWT_SECRET="REPLACE_ME_run_openssl_rand_-base64_48"
JWT_EXPIRES_IN="8h"
# Сгенерировать: openssl rand -base64 48
SESSION_SECRET="REPLACE_ME_run_openssl_rand_-base64_48"

# ─── Шифрование PII (паспортные данные) ───────────────────────────────────────
# !! ОБЯЗАТЕЛЬНО ЗАМЕНИТЬ !!
# Сгенерировать: openssl rand -hex 32
ENCRYPTION_KEY="REPLACE_ME_run_openssl_rand_-hex_32"

# ─── S3-compatible storage (Cloudflare R2 / AWS S3 / MinIO) ──────────────────
# Для локальной разработки можно оставить пустым — загрузка KYC-документов не будет работать,
# но всё остальное работает нормально. Для прода использовать Cloudflare R2.
S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="cryptochange-documents"
S3_PUBLIC_BASE_URL=""

# ─── Quote TTL (seconds) ───────────────────────────────────────────────────────
QUOTE_TTL_SECONDS=300

# ─── Seed Admin ────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@company.co.il"
SEED_ADMIN_PASSWORD="Admin1234!"

# ─── PayBox Business API ──────────────────────────────────────────────────────
# Без ключей — автоматически работает в stub-режиме (логирует предупреждения в консоль)
# Получить в личном кабинете PayBox Business: https://business.payboxpay.com
PAYMENT_PAYBOX_ENABLED=true
PAYBOX_MERCHANT_ID=""
PAYBOX_API_KEY=""
PAYBOX_SECRET=""
PAYBOX_API_URL="https://sandbox.payboxpay.com"

# ─── Bit Business API ─────────────────────────────────────────────────────────
# Без ключей — автоматически работает в stub-режиме (логирует предупреждения в консоль)
# Получить в партнёрской программе Bit: https://business.bit.co.il
PAYMENT_BIT_ENABLED=true
BIT_MERCHANT_ID=""
BIT_API_KEY=""
BIT_SECRET=""
BIT_API_URL="https://api.bit.co.il"

# ─── Crypto-only payments ─────────────────────────────────────────────────────
PAYMENT_CRYPTO_ENABLED=true

# ─── Company wallets (receiving addresses) ────────────────────────────────────
COMPANY_BTC_WALLET=""
COMPANY_ETH_WALLET=""
COMPANY_USDT_TRC20_WALLET=""
COMPANY_USDC_WALLET=""

# ─── Rate source (manual | coingecko | binance) ───────────────────────────────
# manual      — use hardcoded rates from RateConfig in DB
# coingecko   — live rates via CoinGecko free API (30 req/min)
# binance     — live rates via Binance public API
RATE_SOURCE=coingecko

# ─── CoinGecko (optional Pro key for higher rate limits) ─────────────────────
COINGECKO_API_KEY=""

# ─── uPay Israel (manual operator flow — no public API) ──────────────────────
UPAY_ENABLED=false
UPAY_TERMINAL_ID=""
UPAY_USERNAME=""
UPAY_PASSWORD=""

# ─── Company wallets for new assets ──────────────────────────────────────────
COMPANY_SOL_WALLET=""
COMPANY_LTC_WALLET=""
COMPANY_XMR_WALLET=""

# ─── Email уведомления (опционально) ─────────────────────────────────────────
# Без настройки — уведомления сохраняются только в БД, письма не отправляются
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="noreply@company.co.il"
